# Gold Forecast Daily AI Agent — Environment Variables
# Copy this file to .env and fill in the values for local development.
#
# In production (AWS Lambda), secrets are stored in SSM Parameter Store
# under /gold-forecast/* and injected at runtime. STATE_BUCKET_NAME is
# set automatically by SAM from the CloudFormation stack.

# Required: Groq API key for Llama 3.3 70B synthesis (Action 1)
# Get one free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Required: Alpha Vantage API key for NEWS_SENTIMENT (Action 1)
# Get one free at https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day — sufficient for 1 run/day cadence
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Required (local dev only): S3 state bucket name
# In Lambda this is set automatically by SAM. For local dev, leave blank
# to use the local data/ directory fallback (no AWS credentials needed).
# STATE_BUCKET_NAME=goldforecast-state-123456789012

# Required (local dev with S3): AWS credentials
# Not needed locally if STATE_BUCKET_NAME is unset (uses local data/ dir).
# In Lambda, the IAM role provides credentials automatically.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# Required: shared secret used to authenticate the daily cron trigger
# Generate any random string (e.g. `openssl rand -hex 32`)
CRON_SECRET=your_random_cron_secret_here
