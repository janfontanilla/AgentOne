# Gold Forecast Daily AI Agent — Environment Variables
# Copy this file to .env and fill in the values

# Required: Groq API key for Llama 3.3 70B synthesis (Action 1)
# Get one free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Required (Vercel deployment): Upstash Redis credentials for persistence
# Read by @upstash/redis via Redis.fromEnv() in api/forecast.ts and api/history.ts
# Provision at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Required (Vercel deployment): shared secret used to authenticate the daily cron
# Vercel sends this in the Authorization header when triggering /api/forecast
# Generate any random string (e.g. `openssl rand -hex 32`)
CRON_SECRET=your_random_cron_secret_here
